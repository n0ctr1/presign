{
  "name": "presign",
  "version": "0.0.1",
  "private": true,
  "description": "Pre-flight transaction risk advisor for agentic wallets: a machine-readable verdict with data provenance, returned before the agent signs.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "clean": "rm -rf packages/*/dist packages/*/*.tsbuildinfo",
    "demo": "npm run build && node packages/demo/dist/bin.js"
  },
  "devDependencies": {
    "@types/node": "22.13.5",
    "typescript": "5.7.3"
  }
}
