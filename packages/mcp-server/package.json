{
  "name": "@presign/mcp-server",
  "version": "0.0.1",
  "description": "MCP server answering which indexed deployments can serve a risk rule right now, within a freshness budget.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "presign-mcp": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "SKILL.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -b",
    "test": "tsc -b && node --test --experimental-strip-types 'src/**/*.test.ts'"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@presign/operational-layer": "0.0.1",
    "@presign/secrets": "0.0.1",
    "@presign/substreams": "0.0.1",
    "zod": "3.25.76"
  }
}
