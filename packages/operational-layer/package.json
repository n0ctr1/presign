{
  "name": "@presign/operational-layer",
  "version": "0.0.1",
  "description": "Liveness, freshness and capability binding on top of subgraph discovery. Answers: which deployments can answer this rule right now, within this lag budget?",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly",
    "test": "tsc -b && node --test --experimental-strip-types 'src/**/*.test.ts'"
  },
  "dependencies": {
    "@x402/core": "2.25.0",
    "@x402/evm": "2.25.0",
    "@x402/fetch": "2.25.0",
    "viem": "2.56.3"
  }
}
