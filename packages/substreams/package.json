  "scripts": {
    "build": "tsc -b",
    "test": "tsc -b && node --test --experimental-strip-types 'src/**/*.test.ts'"
  },
  "dependencies": {
    "@bufbuild/protobuf": "1.10.0",
    "@connectrpc/connect": "1.6.1",
    "@connectrpc/connect-node": "1.6.1",
    "@substreams/core": "0.17.0",
    "@substreams/manifest": "0.16.0"
  }
}
